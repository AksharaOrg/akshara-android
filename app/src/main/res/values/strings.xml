    <string name="privacy_on_device_title">On your device</string>
    <string name="privacy_on_device_body">Typing stays on your device. Akshara does not send keystrokes, suggestions, or analytics off the device.</string>
    <string name="privacy_permissions_title">Permissions</string>
    <string name="privacy_permissions_body">Akshara has no internet permission. Vibration is used only for keypress haptics. The keyboard can read text fields while it is open, which Android requires for any IME.</string>
    <string name="privacy_clipboard_title">Clipboard history</string>
    <string name="privacy_clipboard_body">Clipboard features are disabled by default. Quick paste shows the latest copied text or compatible image while the keyboard is open. Images are copied temporarily into the app cache so Android can grant the receiving app access, then removed automatically. Clipboard history can save copied text on this device. Clipboard content is never shown in password fields or sent over the network.</string>
    <string name="privacy_predictions_title">Predictions</string>
    <string name="privacy_predictions_body">Word suggestions use compact models bundled with the app. Source corpora are not included and never leave your device.</string>
    <string name="privacy_diagnostics_title">Diagnostics</string>
    <string name="privacy_diagnostics_body">Akshara does not collect crash or analytics data. If you opted into Google Play usage and diagnostics, Google may receive crash reports independently of Akshara. Typed text is never included in those system reports.</string>
    <string name="privacy_tracking_title">No tracking</string>
    <string name="privacy_tracking_body">Akshara has no account, no advertising identifiers, and no third-party analytics or tracking SDKs.</string>
    <string name="privacy_contact_title">Contact</string>
    <string name="notices_akshara_title">Akshara</string>
    <string name="notices_akshara_body">Copyright © 2026 Lahiru Himesh Madusanka. Licensed under the MIT License.</string>
    <string name="notices_source_code">Source code</string>
    <string name="notices_language_title">Language resources</string>
    <string name="notices_frequency_title">A Word Frequency List for Sinhala</string>
    <string name="notices_frequency_body">The bundled frequency model is a compact derivative of the University of Moratuwa National Languages Processing Centre word-frequency list. It retains the first 40,000 high-frequency entries, filters malformed or overlong tokens, and is sorted for on-device prefix lookup.\n\nCitation: Aloka Fernando and Gihan Dias (2021), “Building a Linguistic Resource: A Word Frequency List for Sinhala,” ICON 2021, pages 606–610.</string>
    <string name="notices_frequency_source">Source</string>
    <string name="notices_corpus_title">CleanSinhalaTextCorpus</string>
    <string name="notices_corpus_body">The bundled next-word and trigram models are compact count-only models derived from CleanSinhalaTextCorpus by Remeinium AI and Kusal Darshana (2025). Conversational lines are up-weighted. Source text is not distributed with Akshara.</string>
    <string name="notices_dataset">Dataset</string>
    <string name="notices_dataset_doi">Dataset DOI</string>
    <string name="notices_cc_by">CC BY 4.0</string>
    <string name="notices_english_frequency_title">English word frequencies</string>
    <string name="notices_english_frequency_body">English completions and autocorrection use the 25,000-word frequency export from aparrish/wordfreq-en-25000, derived from rspeer/wordfreq. The bundled data is available under CC BY-SA 4.0; required upstream source attributions are included with the app.</string>
    <string name="notices_english_frequency_source">wordfreq source and attribution</string>
    <string name="notices_privacy_title">Privacy</string>
    <string name="notices_privacy_body">The source corpus is not included in the app. Predictions use the compact on-device models bundled with Akshara.</string>
