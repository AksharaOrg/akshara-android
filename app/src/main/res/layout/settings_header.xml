<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/settings_gutter"
    android:paddingEnd="@dimen/settings_gutter"
    android:paddingTop="20dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/settings_logo"
        android:layout_width="@dimen/settings_logo_size"
        android:layout_height="@dimen/settings_logo_size"
        android:layout_marginEnd="16dp"
        android:background="@drawable/settings_logo_tile"
        android:contentDescription="@null"
        android:foreground="@drawable/settings_logo_frame"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/settings_logo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/settings_hero_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="@dimen/settings_hero_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_hero_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_subtitle"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>
</LinearLayout>
