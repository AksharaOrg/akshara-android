<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/settings_gutter"
    android:paddingEnd="@dimen/settings_gutter"
    android:paddingTop="8dp"
    android:paddingBottom="20dp">

    <ImageView
        android:id="@+id/settings_logo"
        android:layout_width="@dimen/settings_logo_size_large"
        android:layout_height="@dimen/settings_logo_size_large"
        android:background="@drawable/settings_logo_tile"
        android:contentDescription="@null"
        android:foreground="@drawable/settings_logo_frame"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/settings_logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/app_name"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/about_made_by"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?android:attr/textColorSecondary" />
</LinearLayout>
