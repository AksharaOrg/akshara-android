<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn over the logo: invisible in light mode, a faint light edge in dark mode so the dark tile stands out. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1dp" android:color="@color/settings_logo_outline" />
    <corners android:radius="@dimen/settings_logo_radius" />
</shape>
